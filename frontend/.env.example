# ============================================================
# WealthSync Frontend — Environment Configuration
# ============================================================
# Copy this file to .env in the frontend/ directory:
#   cp .env.example .env
# All variables must be prefixed with VITE_ to be available in client code.
# ============================================================

# Backend API base URL (must include /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment label (development | production)
VITE_ENVIRONMENT=development

# ============================================================
# Firebase Authentication Credentials (Spark Free Tier)
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
